{
  "$defs": {
    "AnalyzeResumeV2Response": {
      "properties": {
        "profile": {
          "$ref": "#/$defs/UserProfile"
        },
        "gap_analysis": {
          "$ref": "#/$defs/GapAnalysisV2Response"
        }
      },
      "required": [
        "profile",
        "gap_analysis"
      ],
      "title": "AnalyzeResumeV2Response",
      "type": "object"
    },
    "AnswerIn": {
      "properties": {
        "requirement_id": {
          "description": "follow_up_questions[].requirement_id",
          "title": "Requirement Id",
          "type": "string"
        },
        "answer": {
          "enum": [
            "yes",
            "no",
            "some"
          ],
          "title": "Answer",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional: where or how you did it",
          "title": "Detail"
        }
      },
      "required": [
        "requirement_id",
        "answer"
      ],
      "title": "AnswerIn",
      "type": "object"
    },
    "CloseAlternative": {
      "properties": {
        "soc_code": {
          "title": "Soc Code",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "source": {
          "enum": [
            "related",
            "search"
          ],
          "title": "Source",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "soc_code",
        "title",
        "score",
        "source",
        "message"
      ],
      "title": "CloseAlternative",
      "type": "object"
    },
    "DrawsOnItem": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "item_type": {
          "enum": [
            "knowledge",
            "skill"
          ],
          "title": "Item Type",
          "type": "string"
        },
        "importance": {
          "title": "Importance",
          "type": "number"
        },
        "inferred": {
          "description": "Supported by your matched tasks/DWAs or education; never a gap",
          "title": "Inferred",
          "type": "boolean"
        },
        "support": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support"
        }
      },
      "required": [
        "name",
        "item_type",
        "importance",
        "inferred"
      ],
      "title": "DrawsOnItem",
      "type": "object"
    },
    "EducationEntry": {
      "properties": {
        "degree": {
          "title": "Degree",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "institution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Institution"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "degree"
      ],
      "title": "EducationEntry",
      "type": "object"
    },
    "ErrorDetail": {
      "properties": {
        "code": {
          "description": "UPPER_SNAKE error code, e.g. CORRUPT_FILE",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorResponse": {
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "EvidenceRef": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "work",
            "project",
            "mentioned",
            "self"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Offsets in free_text",
          "title": "Span"
        },
        "context_span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Span"
        },
        "translated": {
          "default": false,
          "description": "text is an English rewrite of original_text",
          "title": "Translated",
          "type": "boolean"
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The evidence as written, when translated or rewritten",
          "title": "Original Text"
        },
        "rewrites": {
          "description": "Shorthand expanded in text ('BP -> blood pressure')",
          "items": {
            "type": "string"
          },
          "title": "Rewrites",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence_type",
        "section"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceVolumeOut": {
      "properties": {
        "units": {
          "description": "Substantive evidence sentences or items",
          "title": "Units",
          "type": "integer"
        },
        "related_share": {
          "description": "Share of the core requirements with any related evidence",
          "title": "Related Share",
          "type": "number"
        },
        "short": {
          "title": "Short",
          "type": "boolean"
        },
        "focus": {
          "default": 1.0,
          "description": "Share of the substantive units related to this occupation",
          "title": "Focus",
          "type": "number"
        },
        "other_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A past job title in an occupation not close to this one",
          "title": "Other Role"
        }
      },
      "required": [
        "units",
        "related_share",
        "short"
      ],
      "title": "EvidenceVolumeOut",
      "type": "object"
    },
    "ExcludedAlternative": {
      "properties": {
        "soc_code": {
          "title": "Soc Code",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "reason": {
          "description": "Why it isn't suggested: a regulated occupation without the qualification, or a higher job zone without a good fit",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "soc_code",
        "title",
        "score",
        "reason"
      ],
      "title": "ExcludedAlternative",
      "type": "object"
    },
    "ExtractedSkill": {
      "description": "A skill in the user's profile, with evidence and an evidence-based level.",
      "properties": {
        "name": {
          "description": "Taxonomy id, e.g. 'python' (INTEGRATION.md skills[].name)",
          "title": "Name",
          "type": "string"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "in_taxonomy": {
          "default": true,
          "title": "In Taxonomy",
          "type": "boolean"
        },
        "is_category": {
          "default": false,
          "description": "A broad field (ai, cloud, devops), not one skill",
          "title": "Is Category",
          "type": "boolean"
        },
        "maps_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Coarser taxonomy id, e.g. postgresql -> sql",
          "title": "Maps To"
        },
        "level": {
          "description": "0 not demonstrated \u2026 5 expert; derived from evidence",
          "maximum": 5,
          "minimum": 0,
          "title": "Level",
          "type": "integer"
        },
        "confidence": {
          "description": "How strongly the evidence supports this skill",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "enum": [
              "self_reported",
              "resume_mentioned",
              "project_supported",
              "work_supported"
            ],
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "claimed_level": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Level the user typed, if any",
          "title": "Claimed Level"
        },
        "needs_verification": {
          "default": false,
          "description": "Claimed level is above what the evidence supports",
          "title": "Needs Verification",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "display",
        "level",
        "confidence",
        "evidence"
      ],
      "title": "ExtractedSkill",
      "type": "object"
    },
    "FitIndicatorItem": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "importance": {
          "title": "Importance",
          "type": "number"
        },
        "level": {
          "title": "Level",
          "type": "number"
        }
      },
      "required": [
        "name",
        "importance",
        "level"
      ],
      "title": "FitIndicatorItem",
      "type": "object"
    },
    "FitRange": {
      "properties": {
        "low": {
          "title": "Low",
          "type": "integer"
        },
        "high": {
          "description": "If the follow-up questions were all answered yes",
          "title": "High",
          "type": "integer"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "FitRange",
      "type": "object"
    },
    "FollowUpQuestionOut": {
      "properties": {
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        },
        "item_type": {
          "title": "Item Type",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "requirement",
        "item_type",
        "question"
      ],
      "title": "FollowUpQuestionOut",
      "type": "object"
    },
    "GapAnalysisV2Request": {
      "properties": {
        "free_text": {
          "anyOf": [
            {
              "maxLength": 50000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Resume text or a description of your work, any style",
          "title": "Free Text"
        },
        "skills": {
          "description": "Typed skills (self-reported)",
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Skills",
          "type": "array"
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v1 UserProfile from /api/v1/skills/analyze_resume"
        },
        "experience_years": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the parsed experience",
          "title": "Experience Years"
        },
        "target_role": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free-text role, e.g. 'staff nurse'; resolved through module 1",
          "title": "Target Role"
        },
        "soc_code": {
          "anyOf": [
            {
              "pattern": "^\\d{2}-\\d{4}\\.\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "O*NET-SOC code, e.g. 29-1141.00",
          "title": "Soc Code"
        },
        "city": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "hours_per_week": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 80,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For roadmap weeks",
          "title": "Hours Per Week"
        },
        "answers": {
          "description": "Answers to follow_up_questions: yes/some become self-reported evidence",
          "items": {
            "$ref": "#/$defs/AnswerIn"
          },
          "maxItems": 20,
          "title": "Answers",
          "type": "array"
        }
      },
      "title": "GapAnalysisV2Request",
      "type": "object"
    },
    "GapAnalysisV2Response": {
      "properties": {
        "resolution": {
          "$ref": "#/$defs/RoleResolution"
        },
        "match_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Match Score",
          "type": "number"
        },
        "fit_percent": {
          "description": "User-facing: threshold -> 50, typical full profile -> 80",
          "maximum": 100,
          "minimum": 0,
          "title": "Fit Percent",
          "type": "integer"
        },
        "fit_label": {
          "description": "Strong fit / Good fit / Developing / Early stage",
          "title": "Fit Label",
          "type": "string"
        },
        "fit_provisional": {
          "default": false,
          "description": "True with insufficient_evidence: see fit_range",
          "title": "Fit Provisional",
          "type": "boolean"
        },
        "fit_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/FitRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "evidence_volume": {
          "$ref": "#/$defs/EvidenceVolumeOut"
        },
        "follow_up_questions": {
          "description": "With insufficient_evidence: answer them in `answers` to re-score",
          "items": {
            "$ref": "#/$defs/FollowUpQuestionOut"
          },
          "title": "Follow Up Questions",
          "type": "array"
        },
        "score_breakdown": {
          "$ref": "#/$defs/ScoreBreakdown"
        },
        "strengths": {
          "items": {
            "$ref": "#/$defs/RequirementResult"
          },
          "title": "Strengths",
          "type": "array"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/RequirementResult"
          },
          "title": "Gaps",
          "type": "array"
        },
        "gaps_total": {
          "title": "Gaps Total",
          "type": "integer"
        },
        "not_applicable_in_india": {
          "description": "Excluded from scoring: outside the scope of practice in India",
          "items": {
            "$ref": "#/$defs/NotApplicableItem"
          },
          "title": "Not Applicable In India",
          "type": "array"
        },
        "role_history": {
          "items": {
            "$ref": "#/$defs/RoleHistoryItem"
          },
          "title": "Role History",
          "type": "array"
        },
        "qualifications": {
          "description": "Degree/institution lines (not task evidence)",
          "items": {
            "type": "string"
          },
          "title": "Qualifications",
          "type": "array"
        },
        "draws_on": {
          "items": {
            "$ref": "#/$defs/DrawsOnItem"
          },
          "title": "Draws On",
          "type": "array"
        },
        "work_activities": {
          "items": {
            "$ref": "#/$defs/WorkActivityItem"
          },
          "title": "Work Activities",
          "type": "array"
        },
        "fit_indicators": {
          "items": {
            "$ref": "#/$defs/FitIndicatorItem"
          },
          "title": "Fit Indicators",
          "type": "array"
        },
        "close_alternatives": {
          "items": {
            "$ref": "#/$defs/CloseAlternative"
          },
          "title": "Close Alternatives",
          "type": "array"
        },
        "alternatives_excluded": {
          "description": "Debug: related occupations left out of close_alternatives / suggested_role",
          "items": {
            "$ref": "#/$defs/ExcludedAlternative"
          },
          "title": "Alternatives Excluded",
          "type": "array"
        },
        "roadmap": {
          "$ref": "#/$defs/GeneralRoadmap"
        },
        "provenance_summary": {
          "$ref": "#/$defs/ProvenanceSummary"
        },
        "m1_version": {
          "title": "M1 Version",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "resolution",
        "match_score",
        "fit_percent",
        "fit_label",
        "verdict",
        "evidence_volume",
        "score_breakdown",
        "strengths",
        "gaps",
        "gaps_total",
        "draws_on",
        "work_activities",
        "fit_indicators",
        "close_alternatives",
        "roadmap",
        "provenance_summary",
        "m1_version"
      ],
      "title": "GapAnalysisV2Response",
      "type": "object"
    },
    "GeneralRoadmap": {
      "properties": {
        "items": {
          "description": "Main roadmap, at most ROADMAP_MAX_ITEMS by weight",
          "items": {
            "$ref": "#/$defs/RoadmapItem"
          },
          "title": "Items",
          "type": "array"
        },
        "later": {
          "description": "The remaining gaps, for after the main roadmap",
          "items": {
            "$ref": "#/$defs/LaterItem"
          },
          "title": "Later",
          "type": "array"
        },
        "basics": {
          "description": "Generic office/productivity software (unless a market skill here)",
          "items": {
            "$ref": "#/$defs/LaterItem"
          },
          "title": "Basics",
          "type": "array"
        },
        "total_hours": {
          "$ref": "#/$defs/HourRange",
          "description": "Main roadmap only"
        },
        "total_weeks": {
          "anyOf": [
            {
              "$ref": "#/$defs/HourRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hours_per_week": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hours Per Week"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "items",
        "total_hours",
        "note"
      ],
      "title": "GeneralRoadmap",
      "type": "object"
    },
    "HourRange": {
      "properties": {
        "low": {
          "title": "Low",
          "type": "integer"
        },
        "high": {
          "title": "High",
          "type": "integer"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "HourRange",
      "type": "object"
    },
    "LaterItem": {
      "properties": {
        "requirement": {
          "title": "Requirement",
          "type": "string"
        },
        "item_type": {
          "title": "Item Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "met",
            "partial",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "requirement",
        "item_type",
        "status",
        "weight"
      ],
      "title": "LaterItem",
      "type": "object"
    },
    "MatchTextRequest": {
      "description": "For module 3: one job's text against the user's evidence.",
      "properties": {
        "free_text": {
          "anyOf": [
            {
              "maxLength": 50000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Resume text or a description of your work, any style",
          "title": "Free Text"
        },
        "skills": {
          "description": "Typed skills (self-reported)",
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Skills",
          "type": "array"
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v1 UserProfile from /api/v1/skills/analyze_resume"
        },
        "experience_years": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the parsed experience",
          "title": "Experience Years"
        },
        "job_text": {
          "maxLength": 50000,
          "minLength": 20,
          "title": "Job Text",
          "type": "string"
        },
        "soc_code": {
          "anyOf": [
            {
              "pattern": "^\\d{2}-\\d{4}\\.\\d{2}$",
              "type": "string"
            },
            {
